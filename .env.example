# PostHog analytics (optional). Both default to the live project when unset —
# set them only to point a fork at a different PostHog project.
#
# VITE_POSTHOG_HOST defaults to `/ingest`, the first-party proxy defined in
# vercel.json and vite.config.js. Set it to https://us.i.posthog.com to talk to
# PostHog directly (simpler, but ad blockers will drop most of the traffic).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
